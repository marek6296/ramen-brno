# Skopíruj ako .env.local a doplň vlastné hodnoty.
# .env.local NIKDY nejde do gitu.

# prihlasovacie meno do adminu (/admin)
ADMIN_USER=
# heslo k tomu menu
ADMIN_PASSWORD=
# ADMIN_SECRET musí mať aspoň 24 znakov, inak lib/auth.ts odmietne podpísať cookie
ADMIN_SECRET=
# kam sa počas vývoja ukladajú obrazovky (voliteľné, inak .data)
TV_DATA_DIR=

# --- Supabase (voliteľné) ---------------------------------------------------
# Keď sú nastavené OBE premenné nižšie, obrazovky sa ukladajú do Supabase.
# Keď chýba čo i len jedna, beží sa nad lokálnym JSON súborom (TV_DATA_DIR) —
# to je režim na vývoj bez databázy.
#
# adresa projektu, napr. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service role kľúč (Supabase → Settings → API). Obchádza RLS, takže sa POUŽÍVA
# VÝHRADNE NA SERVERI a NIKDY nesmie ísť do prehliadača. Preto sa volá bez
# predpony NEXT_PUBLIC_ — Next by ho s ňou zapiekol do klientskeho balíka.
SUPABASE_SERVICE_ROLE_KEY=
#
# Tie isté dve premenné zapínajú aj nahrávanie vlastných obrázkov a videí.
# V projekte na to musí byť VEREJNÝ bucket `tv-media` s limitom 50 MB na súbor
# a povolenými typmi image/jpeg, image/png, image/webp, image/svg+xml
# a video/mp4. Verejný je zámerne: televízor si súbory ťahá priamo z neho,
# bez prihlásenia a bez nášho servera medzi tým. Nahráva sa VÝHRADNE cez
# /api/admin/media, aby kľúč zostal na serveri.

# adresa ChoiceQR, z ktorej sa ťahá menu (voliteľné, inak vaclavska.ramen-brno.cz)
CHOICEQR_BASE=
